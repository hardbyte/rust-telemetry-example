        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "id": 15,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=~\"SPAN_KIND_INTERNAL|SPAN_KIND_CLIENT\"}[$__rate_interval]))))",
          "instant": false,
          "legendFormat": "{{span_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Slowest internal operations (p95, top 8)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
