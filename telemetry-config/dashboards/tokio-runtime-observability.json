              {"color": "yellow", "value": 1024},
              {"color": "red", "value": 2048}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Stack (bytes)"},
            "properties": [
              {"id": "unit", "value": "bytes"},
              {"id": "custom.width", "value": 120}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Lifetime (s)"},
            "properties": [
              {"id": "unit", "value": "s"},
              {"id": "custom.width", "value": 100}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Task Name"},
            "properties": [
