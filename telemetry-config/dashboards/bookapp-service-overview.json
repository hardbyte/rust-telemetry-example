      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(container_cpu_usage_nanoseconds_total{container_name=~\"(.*-(app|backend|db|kafka)).*\"}[5m]) / 1000000000",
          "format": "table",
          "instant": true,
          "refId": "CPU"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "container_memory_percent_ratio{container_name=~\"(.*-(app|backend|db|kafka)).*\"}",
          "format": "table",
          "instant": true,
          "refId": "MEMORY_PCT"
        }
      ],
      "title": "Container Resource Summary",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "container_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #CPU": "CPU %",
              "Value #MEMORY_PCT": "Memory %",
              "container_name": "Container"
            }
          }
        }
      ],
      "type": "table"
    },
