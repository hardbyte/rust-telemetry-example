{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT \n                        id,\n                        title,\n                        author,\n                        status as \"status!: BookStatus\"\n                    FROM books\n                    WHERE status = $1 AND title ILIKE '%' || $2 || '%'\n                    ORDER BY title, author\n                    LIMIT $3\n                    OFFSET $4\n                    ",
