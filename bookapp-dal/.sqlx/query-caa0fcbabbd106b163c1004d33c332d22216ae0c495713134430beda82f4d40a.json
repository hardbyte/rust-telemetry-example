{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT \n                    id,\n                    title,\n                    author,\n                    status as \"status!: BookStatus\"\n                FROM books\n                WHERE \n                    title ILIKE '%' || $1 || '%' \n                    OR author ILIKE '%' || $1 || '%'\n                ORDER BY title\n                LIMIT $2\n                OFFSET $3\n                ",
