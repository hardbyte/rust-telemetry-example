{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT \n                        id,\n                        title,\n                        author,\n                        status as \"status!: BookStatus\"\n                    FROM books\n                    WHERE status = $1 \n                        AND author ILIKE '%' || $2 || '%'\n                        AND title ILIKE '%' || $3 || '%'\n                    ORDER BY title, author\n                    LIMIT $4\n                    OFFSET $5\n                    ",
