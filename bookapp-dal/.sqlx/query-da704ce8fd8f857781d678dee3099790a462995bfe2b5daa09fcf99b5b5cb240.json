  "query": "\n            SELECT\n                work_id,\n                author_id,\n                role,\n                primary_author,\n                ord,\n                created_at,\n                updated_at\n            FROM work_authors\n            WHERE work_id = $1\n            ORDER BY ord NULLS LAST, created_at, author_id\n            ",
