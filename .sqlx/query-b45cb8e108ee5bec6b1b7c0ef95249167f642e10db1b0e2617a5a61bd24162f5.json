{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                  id,\n                  occurred_at,\n                  aggregate_type,\n                  aggregate_id,\n                  event_type,\n                  payload     as \"payload!\",\n                  headers     as \"headers!\",\n                  trace_id,\n                  span_id,\n                  source_service,\n                  version,\n                  topic,\n                  published_at,\n                  publish_attempts,\n                  publish_error\n                FROM events\n                WHERE published_at IS NULL AND topic = $1\n                ORDER BY occurred_at, id\n                LIMIT $2\n                ",
